# Copy to .env (never commit .env). Fill real values locally / in host dashboards.

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=            # safe for the browser (RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=    # SERVER ONLY (api + ingest). Never in apps/web client code.
SUPABASE_DB_URL=              # Postgres connection string for migrations / worker

# ---- Gemini ----
GEMINI_API_KEY=               # server only
GEMINI_EMBED_MODEL=           # check current model name in Gemini docs
GEMINI_CHAT_MODEL=

# ---- Email (alerts) ----
RESEND_API_KEY=
ALERTS_FROM_EMAIL=

# ---- Abuse control ----
TURNSTILE_SITE_KEY=           # public (web)
TURNSTILE_SECRET_KEY=         # server only

# ---- Observability ----
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- App ----
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:8000
CRAWLER_USER_AGENT=GazetteWatchLK/0.1 (+contact email)
